  "dismiss": {"operation": "ui.dismiss", "arguments": {}},
  "keep": {"operation": "settings.system.confirm", "arguments": {"request": {"state": "settings.request"}}},
  "revert": {"operation": "settings.system.revert", "arguments": {"request": {"state": "settings.request"}}},
  "retry": {"operation": "settings.system.retry", "arguments": {"request": {"state": "settings.request"}}},
  "modeNext": {
   "operation": "settings.system.displayMode",
   "arguments": {
    "index": {
     "op": "%",
     "args": [
      {"op": "+", "args": [{"state": "settings.display.mode.selected"}, 1]},
      {"op": "max", "args": [{"state": "settings.display.mode.optionCount"}, 1]}
     ]
    },
    "catalog": {"state": "settings.display.catalog"}
   }
  },
  "soundForward": {"operation": "session.menu", "arguments": {"command": "soundForward"}},
  "soundBack": {"operation": "session.menu", "arguments": {"command": "soundBack"}},
  "preset.low": {"operation": "settings.system.preset", "arguments": {"name": "low"}},
  "preset.balanced": {"operation": "settings.system.preset", "arguments": {"name": "balanced"}},
  "preset.quality": {"operation": "settings.system.preset", "arguments": {"name": "quality"}},
  "preset.ultra": {"operation": "settings.system.preset", "arguments": {"name": "ultra"}},
  "system_fullscreenClear": {"operation": "settings.system.edit", "arguments": {"r_fullscreen": false}},
  "system_fullscreenSet": {"operation": "settings.system.edit", "arguments": {"r_fullscreen": true}},
  "system_brightnessSet": {"input": "number", "operation": "settings.system.edit", "arguments": {"r_brightness": {"input": "value"}}},
  "vsyncOn": {"operation": "settings.system.edit", "arguments": {"r_swapInterval": 1}},
  "vsyncOff": {"operation": "settings.system.edit", "arguments": {"r_swapInterval": 0}},
  "aa0": {"operation": "settings.system.edit", "arguments": {"r_multiSamples": 0}},
  "aa8": {"operation": "settings.system.edit", "arguments": {"r_multiSamples": 8}},
  "aa4": {"operation": "settings.system.edit", "arguments": {"r_multiSamples": 4}},
  "aa2": {"operation": "settings.system.edit", "arguments": {"r_multiSamples": 2}},
  "system_shadowsClear": {"operation": "settings.system.edit", "arguments": {"r_shadows": false}},
  "system_shadowsSet": {"operation": "settings.system.edit", "arguments": {"r_shadows": true}},
  "system_specularClear": {"operation": "settings.system.edit", "arguments": {"r_skipSpecular": false}},
  "system_specularSet": {"operation": "settings.system.edit", "arguments": {"r_skipSpecular": true}},
  "system_bumpClear": {"operation": "settings.system.edit", "arguments": {"r_skipBump": false}},
  "system_bumpSet": {"operation": "settings.system.edit", "arguments": {"r_skipBump": true}},
  "system_volumeSet": {
   "operation": "settings.player.set",
   "input": "number",
   "arguments": {"cvar": "s_volume_dB", "value": {"input": "value"}}
  },
  "system_reverseOn": {"operation": "settings.player.set", "arguments": {"cvar": "s_reverse", "value": true}},
  "system_reverseOff": {"operation": "settings.player.set", "arguments": {"cvar": "s_reverse", "value": false}}
 },
 "events": {
  "system_qualityStep": [
   {
    "op": "if",
    "condition": {"op": "==", "args": [{"state": "settings.draft.com_performancePreset"}, "low"]},
    "then": [{"op": "action", "action": "preset.balanced"}],
    "else": [
     {
      "op": "if",
      "condition": {"op": "==", "args": [{"state": "settings.draft.com_performancePreset"}, "balanced"]},
      "then": [{"op": "action", "action": "preset.quality"}],
      "else": [
       {
        "op": "if",
        "condition": {"op": "==", "args": [{"state": "settings.draft.com_performancePreset"}, "quality"]},
        "then": [{"op": "action", "action": "preset.ultra"}],
        "else": [{"op": "action", "action": "preset.low"}]
       }
      ]
     }
    ]
   }
  ],
  "system_fullscreenStep": [
   {
    "op": "if",
    "condition": {"state": "settings.draft.r_fullscreen"},
    "then": [{"op": "action", "action": "system_fullscreenClear"}],
    "else": [{"op": "action", "action": "system_fullscreenSet"}]
   }
  ],
  "system_sizeStep": [{"op": "action", "action": "modeNext"}],
  "system_vsyncStep": [
   {
    "op": "if",
    "condition": {"op": "==", "args": [{"state": "settings.draft.r_swapInterval"}, 0]},
    "then": [{"op": "action", "action": "vsyncOn"}],
    "else": [{"op": "action", "action": "vsyncOff"}]
   }
  ],
  "system_aaStep": [
   {
    "op": "if",
    "condition": {"op": "==", "args": [{"state": "settings.draft.r_multiSamples"}, 0]},
    "then": [{"op": "action", "action": "aa2"}],
    "else": [
     {
      "op": "if",
      "condition": {"op": "==", "args": [{"state": "settings.draft.r_multiSamples"}, 2]},
      "then": [{"op": "action", "action": "aa4"}],
      "else": [
       {
        "op": "if",
        "condition": {"op": "==", "args": [{"state": "settings.draft.r_multiSamples"}, 4]},
        "then": [{"op": "action", "action": "aa8"}],
        "else": [{"op": "action", "action": "aa0"}]
       }
      ]
     }
    ]
   }
  ],
  "system_shadowsStep": [
   {
    "op": "if",
    "condition": {"state": "settings.draft.r_shadows"},
    "then": [{"op": "action", "action": "system_shadowsClear"}],
    "else": [{"op": "action", "action": "system_shadowsSet"}]
   }
  ],
  "system_specularStep": [
   {
    "op": "if",
    "condition": {"state": "settings.draft.r_skipSpecular"},
    "then": [{"op": "action", "action": "system_specularClear"}],
    "else": [{"op": "action", "action": "system_specularSet"}]
   }
  ],
  "system_bumpStep": [
   {
    "op": "if",
    "condition": {"state": "settings.draft.r_skipBump"},
    "then": [{"op": "action", "action": "system_bumpClear"}],
    "else": [{"op": "action", "action": "system_bumpSet"}]
   }
  ],
  "system_reverseStep": [
   {
    "op": "if",
    "condition": {"state": "cvar.s_reverse"},
    "then": [{"op": "action", "action": "system_reverseOff"}],
    "else": [{"op": "action", "action": "system_reverseOn"}]
   }
  ],
  "apply": [{"op": "if", "condition": {"state": "settings.canApply"}, "then": [{"op": "action", "action": "apply"}]}],
  "confirmationBack": [{"op": "if", "condition": {"state": "settings.canRevert"}, "then": [{"op": "action", "action": "revert"}]}],
  "continueEditing": [{"op": "setState", "values": {"page.discardVisible": false}}, {"op": "action", "action": "soundBack"}],
  "discard": [
   {
    "op": "if",
    "condition": {"op": "&&", "args": [{"state": "page.discardVisible"}, {"op": "!", "args": [{"state": "settings.busy"}]}]},
    "then": [
     {"op": "action", "action": "cancel"},
     {"op": "setState", "values": {"page.discardVisible": false}},
     {"op": "action", "action": "dismiss"}
    ]
   }
  ],
  "onBack": [
   {
    "op": "if",
    "condition": {"state": "page.discardVisible"},
    "then": [{"op": "call", "event": "continueEditing"}],
    "else": [
     {
      "op": "if",
      "condition": {
       "op": "&&",
       "args": [
        {"op": "!", "args": [{"state": "settings.busy"}]},
        {
         "op": "||",
         "args": [
          {"op": "==", "args": [{"state": "settings.phase"}, 0]},
          {"op": "==", "args": [{"state": "settings.phase"}, 1]}
         ]
        }
       ]
      },
      "then": [
       {
        "op": "if",
        "condition": {"state": "settings.dirty"},
        "then": [{"op": "setState", "values": {"page.discardVisible": true}}, {"op": "action", "action": "soundForward"}],
        "else": [{"op": "action", "action": "cancel"}, {"op": "action", "action": "dismiss"}]
       }
      ]
     }
    ]
   }
  ],
  "pageShown": [{"op": "setState", "values": {"page.shown": true}}],
  "onActivate": [
   {"op": "action", "action": "begin"},
   {"op": "setState", "values": {"page.discardVisible": false}},
   {"op": "setState", "values": {"page.shown": false}},
   {"op": "playTimeline", "timeline": "pageEnter"},
   {"op": "playTimeline", "timeline": "pageContent"},
   {"op": "playTimeline", "timeline": "edgeGlow"}
  ]
 },
