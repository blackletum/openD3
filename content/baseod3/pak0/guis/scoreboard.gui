//
// openD3's multiplayer scoreboard: Doom 3's board, built by name from its art,
// with a row for each of 16 seats. It lays out the rows the server seats
// (gui::slots): four at Doom 3's spacing on a server of up to four, eight in
// the same height up to eight, and one per seat beyond, the board growing down.
windowDef Desktop {
	rect		0, 0, 640, 480
	menugui		0
	nocursor	1
	onActivate {
		resetTime "Sequence" "0" ;
	}
	onDeactivate {
		set "Open::forecolor" "1 0 0 0" ;
	}
	windowDef Calc {
		rect		0, 0, 0, 0
		noevents	1
		forecolor	40 - ( 22 * ( "gui::slots" > 4 ) + 2 * ( "gui::slots" > 8 ) ), 16 - 2 * ( "gui::slots" > 4 ), 4 + 4 * ( "gui::slots" > 4 ) + ( "gui::slots" - 8 ) * ( "gui::slots" > 8 ), ( "gui::slots" > 4 )
	}
	windowDef Calc2 {
		rect		0, 0, 0, 0
		noevents	1
		forecolor	21 + ( "Calc::forecolor"[2] - 1 ) * "Calc::forecolor"[0] + "Calc::forecolor"[1], 0, 0, 0
	}
	windowDef Calc3 {
		rect		0, 0, 0, 0
		noevents	1
		forecolor	79 + "Calc2::forecolor"[0], 114 + "Calc2::forecolor"[0], 0, 0
	}
	windowDef Open {
		rect		0, 0, 0, 0
		noevents	1
		forecolor	1, 0, 0, 0
	}
	windowDef Sequence {
		rect		0, 0, 0, 0
		notime		1
		noevents	1
		onTime 0 {
			transition "Open::forecolor" "1 0 0 0" "0 0 0 0" "400" "0" "0.8" ;
			transition "BoxBg::backcolor" "1 1 1 0.2" "0.25 0.35 0.35 0.4" "70" ;
		}
		onTime 70 {
			transition "BoxBg::backcolor" "1 1 1 0.2" "0.1 0.2 0.2 0.5" "300" ;
		}
		onTime 100 {
			transition "Well1::bordercolor" "1 1 1 0.2" "0 0 0 1" "300" ;
		}
		onTime 150 {
			transition "Well2::bordercolor" "1 1 1 0.2" "0 0 0 1" "300" ;
			transition "Well1a::bordercolor" "1 1 1 0.2" "0 0 0 1" "300" ;
		}
		onTime 200 {
			transition "Well3::bordercolor" "1 1 1 0.2" "0 0 0 1" "300" ;
			transition "Well2a::bordercolor" "1 1 1 0.2" "0 0 0 1" "300" ;
		}
		onTime 250 {
			transition "Well4::bordercolor" "1 1 1 0.2" "0 0 0 1" "300" ;
			transition "Well3a::bordercolor" "1 1 1 0.2" "0 0 0 1" "300" ;
		}
		onTime 300 {
			transition "Well4a::bordercolor" "1 1 1 0.2" "0 0 0 1" "300" ;
		}
	}
