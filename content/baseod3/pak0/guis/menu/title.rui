   {"op": "playTimeline", "timeline": "edgeGlow"}
  ],
  "depart": [
   {"op": "playTimeline", "timeline": "depart"},
   {"op": "playTimeline", "timeline": "barOut"},
   {"op": "call", "event": "navPage"}
  ],
  "release": [{"op": "playTimeline", "timeline": "release"}]
