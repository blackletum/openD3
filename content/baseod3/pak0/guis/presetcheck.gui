// openD3's system check for the stock interface: shown before the main menu
// when the performance presets have changed since this configuration last
// checked them (src/framework/Session_presetcheck.cpp). Built from the retail
// menu's stars and Mars and the retail message box's art, by name only.
//
// With ui_retained 1 the session draws this screen's scene under
// guis/menu/presetcheck.rui and hides CheckDialog. The plate stands at
// (100, 75), 440 x 330, in both, so a change to one belongs in the other
// (tools/ui/doom3_menu_presetcheck.py). The session publishes every value
// already localized and takes presetCheckApply, presetCheckKeep and
// presetCheckLater.
windowDef Desktop
{
	rect		0, 0, 640, 480
	backcolor	0, 0, 0, 1
	menugui		1

	// Back asks again at the next start; it changes no setting.
	onESC {
		if ( "gui::check_busy" == 0 ) {
			set "cmd" "play guisounds_menuclickup ; presetCheckLater" ;
		}
	}

	onActivate {
		resetTime "CheckIntro" "0" ;
		resetTime "MarsSpin" "0" ;
	}

	// The menu's scene where its opening leaves it.
	windowDef Stars
	{
		rect		-205, -70, 1024, 1024
		background	"gui/mainmenu/star"
		matcolor	0.7, 0.7, 0.7, 0.7
		matscalex	4
		matscaley	4
		screenstretchx	fill
		screenstretchy	fill
		noevents	1
	}
	windowDef Stars1
	{
		rect		-205, -90, 1024, 1024
		background	"gui/mainmenu/star1"
		matcolor	1, 1, 1, 1
		matscalex	10
		matscaley	10
		screenstretchx	fill
		screenstretchy	fill
		noevents	1
	}
	windowDef Stars2
	{
		rect		-205, -110, 1024, 1024
		background	"gui/mainmenu/star3"
		matcolor	1, 1, 1, 1
		matscalex	4
		matscaley	4
		screenstretchx	fill
		screenstretchy	fill
		noevents	1
	}
	renderDef MarsRender
	{
		rect		0, 20, 640, 430
		backcolor	0, 0, 0, 0.4
		model		"models/wipes/planet2.lwo"
		needsRender	1
		modelRotate	0, 0, 0, 0
		modelOrigin	-80, 0, -25, 0
		viewOffset	-128, 0, 0, 0
		lightOrigin	-128, 10, 150, 0
		lightColor	1, 1, 1, 1
		notime		1
		noevents	1
	}
	windowDef MarsSpin
	{
		rect		0, 0, 0, 0
		noevents	1
		notime		1

		onTime 0 {
			transition "MarsRender::modelRotate" "0 0 0 0" "0 -360 0 0" "500000" ;
		}
		onTime 500000 {
			resetTime "0" ;
		}
	}
	windowDef MarsHighlight
	{
		rect		133, 57, 373, 373
		background	"gui/mainmenu/marshighlight"
		matcolor	0.7, 0.7, 0.7, 0.7
		noevents	1
	}

