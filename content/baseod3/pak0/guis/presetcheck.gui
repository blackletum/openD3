					textscale	0.25
					textalign	1
					textaligny	-1
					forecolor	0.6, 1, 1, 1
					nowrap	1

					onMouseEnter {
						transition "forecolor" "0.6 1 1 1" "1 1 1 1" "250" ;
						transition "CheckApplyEdgeG::matcolor" "0.8 0.9 1 1" "0.55 0.65 0.75 1" "250" ;
						transition "CheckApplyBorderG::matcolor" "0.8 0.9 1 1" "0.55 0.65 0.75 1" "250" ;
