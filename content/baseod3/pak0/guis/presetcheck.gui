						transition "CheckApplyCorner::matcolor" "0.45 0.55 0.7 0.3" "0.55 0.65 0.75 0.5" "200" ;
					}

					onMouseExit {
						set "forecolor" "0.6 1 1 1" ;
						set "CheckApplyEdgeG::matcolor" "0.55 0.65 0.75 0.5" ;
						set "CheckApplyBorderG::matcolor" "0.55 0.65 0.75 0.5" ;
						set "CheckApplyCornerG::matcolor" "0.55 0.65 0.75 0.5" ;
						set "CheckApplyBorder::backcolor" "0.45 0.55 0.7 0.3" ;
						set "CheckApplyCorner::matcolor" "0.45 0.55 0.7 0.3" ;
					}

					onActionRelease {
						set "cmd" "play guisounds_menuclickup ; presetCheckApply" ;
					}
				}
				windowDef CheckKeepBtn
				{
					rect		225, 270, 190, 32
					noevents	1
					windowDef CheckKeepBorder
					{
						rect		4, 6, 170, 19
						backcolor	0.45, 0.55, 0.7, 0.3
						noevents	1
					}
					windowDef CheckKeepCorner
					{
						rect		174, 0, 16, 32
						background	"gui/mainmenu/button_cornerangle"
						matcolor	0.45, 0.55, 0.7, 0.3
						noevents	1
					}
					windowDef CheckKeepEdgeG
					{
						rect		0, 0, 16, 32
						background	"gui/mainmenu/buttong_cornersquare"
						matcolor	0.55, 0.65, 0.75, 0.5
						noevents	1
					}
					windowDef CheckKeepBorderG
					{
						rect		16, 0, 158, 32
						background	"gui/mainmenu/buttong_middlesm"
						matcolor	0.55, 0.65, 0.75, 0.5
						noevents	1
					}
					windowDef CheckKeepCornerG
					{
						rect		174, 0, 16, 32
						background	"gui/mainmenu/buttong_cornerangle"
						matcolor	0.55, 0.65, 0.75, 0.5
						noevents	1
					}
				}
				windowDef CheckKeepText
				{
					rect		229, 276, 170, 19
					text		"#str_232012"
					font		"fonts/english"
					textscale	0.25
					textalign	1
					textaligny	-1
					forecolor	0.6, 1, 1, 1
					nowrap	1

					onMouseEnter {
						transition "forecolor" "0.6 1 1 1" "1 1 1 1" "250" ;
						transition "CheckKeepEdgeG::matcolor" "0.8 0.9 1 1" "0.55 0.65 0.75 1" "250" ;
						transition "CheckKeepBorderG::matcolor" "0.8 0.9 1 1" "0.55 0.65 0.75 1" "250" ;
						transition "CheckKeepCornerG::matcolor" "0.8 0.9 1 1" "0.55 0.65 0.75 1" "250" ;
						transition "CheckKeepBorder::backcolor" "0.45 0.55 0.7 0.3" "0.55 0.65 0.75 0.5" "200" ;
						transition "CheckKeepCorner::matcolor" "0.45 0.55 0.7 0.3" "0.55 0.65 0.75 0.5" "200" ;
					}

					onMouseExit {
						set "forecolor" "0.6 1 1 1" ;
						set "CheckKeepEdgeG::matcolor" "0.55 0.65 0.75 0.5" ;
						set "CheckKeepBorderG::matcolor" "0.55 0.65 0.75 0.5" ;
						set "CheckKeepCornerG::matcolor" "0.55 0.65 0.75 0.5" ;
						set "CheckKeepBorder::backcolor" "0.45 0.55 0.7 0.3" ;
						set "CheckKeepCorner::matcolor" "0.45 0.55 0.7 0.3" ;
					}

					onActionRelease {
						set "cmd" "play guisounds_menuclickup ; presetCheckKeep" ;
					}
				}
				windowDef CheckLater
				{
					rect		120, 302, 200, 16
					text		"#str_232013"
					font		"fonts/english"
					textscale	0.25
					textalign	1
					forecolor	1, 1, 1, 0.4
					nowrap	1

					onMouseEnter {
						transition "forecolor" "1 1 1 0.4" "1 1 1 1" "100" ;
					}
					onMouseExit {
						transition "forecolor" "1 1 1 1" "1 1 1 0.4" "200" ;
					}
					onActionRelease {
						set "cmd" "play guisounds_menuclickup ; presetCheckLater" ;
					}
				}
			}
		}
	}

	// The retail message box's entrance: the dim, then the plate.
	windowDef CheckIntro
	{
		rect		0, 0, 0, 0
		notime		1
		noevents	1

		onTime 0 {
			set "CheckPlate::visible" "0" ;
			transition "CheckDim::backcolor" "0 0 0 0" "0 0 0 0.5" "200" ;
		}
		onTime 200 {
			set "CheckPlate::visible" "1" ;
		}
	}
}
